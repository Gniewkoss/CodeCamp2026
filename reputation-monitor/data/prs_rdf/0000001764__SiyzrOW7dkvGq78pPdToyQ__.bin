            }
            .awimg {
                position:absolute;
            }
            .awsvg {
                position:absolute;
            }
            .awpage {
                position:relative;
                border:solid 1pt black;
                margin:10pt auto 10pt auto;
                overflow:hidden;
            }
            @media print {
                body {
                    margin:0pt;
                    padding:0pt;
                }
                .awpage {
                    page-break-after:always;
                    margin:0pt;
                    padding:0pt;
                }
            }
            .awtext001 {
                font-family:'Georgia';
                font-style:normal;
                font-weight:normal;
            }
            .awtext002 {
