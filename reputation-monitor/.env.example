# Copy to .env and fill in. Never commit .env to git.

DATABASE_URL=sqlite:///./repmonitor.db

# LLM: anthropic (default) or openai — see app/llm.py
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=2200

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1600

NEWSAPI_KEY=

# GUS BIR / REGON (free, https://api.stat.gov.pl/Home/RegonApi)
# Production service URL (default in app):
GUS_BIR_API_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_BIR_API_KEY=your_gus_key_from_STAT
GUS_BIR_ENABLED=true

# CEIDG — JWT from biznes.gov.pl
CEIDG_API_TOKEN=

CEIDG_API_URL=https://dane.biznes.gov.pl/api/ceidg/v3
CEIDG_V2_API_URL=https://dane.biznes.gov.pl/api/ceidg/v2

GDELT_ENABLED=true
MAX_ARTICLES_PER_SCAN=100
