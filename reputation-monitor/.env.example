# Copy to .env and fill in your keys.

# SQLite (default, zero-setup): sqlite:///./repmonitor.db
# Postgres:                     postgresql+psycopg2://user:pass@localhost:5432/repmonitor
DATABASE_URL=sqlite:///./repmonitor.db

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

NEWSAPI_KEY=
GDELT_ENABLED=true

# ─── Polish business registries ────────────────────────────────────
# GUS BIR (REGON) — off until you receive a key from GUS (BIR1).
# Then: GUS_BIR_ENABLED=true, GUS_BIR_API_KEY=..., and production URL if needed.
GUS_BIR_API_URL=https://wyszukiwarkaregontest.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_BIR_API_KEY=
GUS_BIR_ENABLED=false

# CEIDG v3 (sole traders / JDG). Requires a free JWT token — issued at
# https://dane.biznes.gov.pl/api/documentation after registration.
# Leave empty to disable (safe default).
CEIDG_API_URL=https://dane.biznes.gov.pl/api/ceidg/v3
CEIDG_V2_API_URL=https://dane.biznes.gov.pl/api/ceidg/v2
CEIDG_API_TOKEN=

# Sanctions XML cache (Docker: /data/sanctions)
SANCTIONS_CACHE_DIR=./data/sanctions
